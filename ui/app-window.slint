import {
    Button,
    VerticalBox,
    Spinner,
    Palette,
    Slider,
    ScrollView,
} from "std-widgets.slint";
import { Style } from "global-styles.slint";
export { MessageDialog } from "message-dialog.slint";
export { ExportImageWindow } from "export-image-window.slint";
// ThemeはWindowごとに保有されるため、ExportしてDialogを開く際にThemeを必ず渡す
export { Palette } from "std-widgets.slint";

struct FrameData {
    image: image,
    delay: int,
}

export component AppWindow inherits Window {
    in property <int> gif-frame-count: frames.length;
    in property <bool> is-loading: false;
    in-out property <int> current-tab: 0;
    in property <string> total_duration: "00:00";
    in-out property <[FrameData]> frames: [];
    in-out property <int> selected-frame-index: 0;
    in-out property <bool> is-play: false;
    in-out property <bool> is-repeat: true;
    in-out property <length> sidebar-width: 200px;
    in property <string> current-filename: "";
    in property <int> canvas-width: 0;
    in property <int> canvas-height: 0;
    callback pick-gif();
    callback show-test-dialog();
    callback play(int);
    callback export-gif();
    callback export-selected-image();

    title: "GIF IDE";
    default-font-family: Style.font-family;
    preferred-height: 560px;
    preferred-width: 900px;

    VerticalLayout {
        // Header
        HorizontalLayout {
            alignment: space-between;
            padding: 12px;
            spacing: 20px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "GIF IDE";
                    font-size: 16px;
                }
            }

            // Theme Button
            VerticalLayout {
                alignment: center;

                Button {
                    icon: Palette.color-scheme == ColorScheme.dark ? @image-url("assets/sun.svg") : @image-url("assets/moon.svg");
                    colorize-icon: true;
                    clicked => {
                        if (Palette.color-scheme == ColorScheme.dark) {
                            Palette.color-scheme = ColorScheme.light;
                        } else {
                            Palette.color-scheme = ColorScheme.dark;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Palette.foreground.transparentize(0.7);
        }

        HorizontalLayout {
            // Main Display
            VerticalLayout {
                // Image Display
                VerticalLayout {
                    vertical-stretch: 1;
                    padding-bottom: 12px;

                    if !is-loading && frames.length == 0: Button {
                        text: "Pick GIF";
                        clicked => root.pick-gif();
                    }

                    if is-loading: Spinner {
                        indeterminate: true;
                    }

                    if frames.length > 0: Image {
                        source: frames[selected-frame-index].image;
                    }
                }

                // Play Bar
                VerticalLayout {
                    alignment: center;
                    vertical-stretch: 0;

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.transparentize(0.7);
                    }

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("assets/skip-back.svg");
                                    colorize-icon: true;
                                    enabled: frames.length > 0;
                                    clicked => {
                                        let prev = selected-frame-index - 1;
                                        root.selected-frame-index = prev < 0 ? frames.length - 1 : prev;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: is-play ? @image-url("assets/stop.svg") : @image-url("assets/play.svg");
                                    colorize-icon: true;
                                    primary: true;
                                    enabled: frames.length > 0;
                                    clicked => {
                                        is-play = !is-play;
                                        root.play(selected-frame-index);
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("assets/skip-forward.svg");
                                    colorize-icon: true;
                                    enabled: frames.length > 0;
                                    clicked => {
                                        let next = selected-frame-index + 1;
                                        root.selected-frame-index = next >= frames.length ? 0 : next;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    icon: @image-url("assets/repeat.svg");
                                    colorize-icon: true;
                                    primary: is-repeat;
                                    clicked => {
                                        is-repeat = !is-repeat;
                                    }
                                }
                            }
                        }

                        Slider {
                            enabled: frames.length > 0;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "00:00";
                                    font-size: 14px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: "/";
                                    font-size: 14px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: total_duration;
                                    font-size: 14px;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.transparentize(0.7);
                    }
                }

                // Frame Bar
                VerticalLayout {
                    alignment: center;
                    vertical-stretch: 0;
                    padding: 12px;

                    property <length> fling-velocity: 0px;

                    inertia-timer := Timer {
                        interval: 16ms;
                        triggered => {
                            let max-scroll = frame-list.preferred-width - frame-scroll.visible-width;
                            frame-scroll.viewport-x = clamp(frame-scroll.viewport-x + fling-velocity, -max-scroll, 0px);
                            fling-velocity = fling-velocity * 0.92;
                            if (abs(fling-velocity) < 0.5px) {
                                self.running = false;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-bottom: 8px;
                        alignment: end;
                        Text {
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.4);
                            text: gif-frame-count + " frames";
                        }
                    }

                    frame-scroll := ScrollView {
                        viewport-width: frame-list.preferred-width;
                        height: frame-list.preferred-height;

                        frame-list := HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-bottom: 22px;
                            for frame[i] in frames: TouchArea {
                                property <bool> is-dragging: false;

                                // フリックスクロール動作
                                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        is-dragging = false;
                                        fling-velocity = 0px;
                                        inertia-timer.running = false;
                                    }
                                    if (e.kind == PointerEventKind.up && is-dragging) {
                                        if (abs(fling-velocity) > 1px) {
                                            inertia-timer.running = true;
                                        }
                                    }
                                }
                                moved => {
                                    let dx = self.mouse-x - self.pressed-x;
                                    if (abs(dx) > 4px || is-dragging) {
                                        is-dragging = true;
                                        let prev-x = frame-scroll.viewport-x;
                                        let max-scroll = frame-list.preferred-width - frame-scroll.visible-width;
                                        frame-scroll.viewport-x = clamp(frame-scroll.viewport-x + dx, -max-scroll, 0px);
                                        fling-velocity = frame-scroll.viewport-x - prev-x;
                                    }
                                }
                                clicked => {
                                    if (!is-dragging) {
                                        root.selected-frame-index = i;
                                    }
                                }
                                width: 64px;
                                height: 50px;

                                Rectangle {
                                    border-width: 1px;
                                    border-color: root.selected-frame-index == i ? Palette.accent-background : parent.has-hover ? Palette.accent-background.transparentize(0.5) : Palette.foreground.transparentize(0.7);
                                    border-radius: 4px;
                                    clip: true;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: frame.image;
                                        image-fit: cover;
                                    }

                                    Rectangle {
                                        x: 4px;
                                        y: parent.height - self.height - 4px;
                                        width: num.preferred-width + 6px;
                                        height: num.preferred-height + 2px;
                                        border-radius: 2px;
                                        background: Palette.background.transparentize(0.3);

                                        num := Text {
                                            x: 3px;
                                            font-size: 10px;
                                            color: Palette.foreground;
                                            text: i + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Divider
            Rectangle {
                width: 5px;

                Rectangle {
                    width: 1px;
                    height: 100%;
                    x: (parent.width - self.width) / 2;
                    background: Palette.foreground.transparentize(0.7);
                }

                TouchArea {
                    mouse-cursor: col-resize;
                    property <length> start-abs-x: 0px;
                    property <length> start-sidebar-width: 0px;

                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            start-abs-x = self.absolute-position.x + self.mouse-x;
                            start-sidebar-width = root.sidebar-width;
                        }
                    }

                    moved => {
                        root.sidebar-width = max(60px, min(500px,
                            start-sidebar-width - (self.absolute-position.x + self.mouse-x - start-abs-x)));
                    }
                }
            }

            // Side Bar
            VerticalLayout {
                width: root.sidebar-width;

                // 設定/その他
                HorizontalLayout {
                    alignment: start;
                    padding-top: 12px;
                    padding-right: 12px;
                    padding-left: 12px;
                    padding-bottom: 4px;
                    spacing: 20px;

                    for label[i] in ["設定", "その他"]: TouchArea {
                        clicked => {
                            root.current-tab = i;
                        }

                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                height: 20px;
                                vertical-alignment: center;
                                text: label;
                                font-size: 14px;
                                color: root.current-tab == i ? Palette.foreground : Palette.foreground.transparentize(0.5);
                            }

                            Rectangle {
                                height: 2px;
                                border-radius: 1px;
                                background: root.current-tab == i ? Palette.accent-background : transparent;
                            }
                        }
                    }
                    Rectangle { }
                }

                Rectangle {
                    height: 1px;
                    background: Palette.foreground.transparentize(0.7);
                }

                if current-tab == 0: VerticalLayout {
                    alignment: start;

                    // File Info
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        alignment: center;

                        // 小見出し
                        Text {
                            text: "GIF 情報";
                            font-size: 13px;
                            font-weight: FontWeight.medium;
                            color: Palette.foreground.transparentize(0.3);
                        }

                        // ファイル名
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "ファイル名";
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }

                            Text {
                                text: current-filename == "" ? "---" : current-filename;
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }
                        }

                        // 総フレーム数
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "総フレーム数";
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }

                            Text {
                                text: gif-frame-count == 0 ? "---" : gif-frame-count;
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }
                        }

                        // GIF Canvasサイズ
                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "サイズ";
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }

                            Text {
                                text: canvas-width == 0 ? "---" : canvas-width + " x " + canvas-height;
                                font-size: 12px;
                                color: Palette.foreground.transparentize(0.5);
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.transparentize(0.7);
                    }

                    // Export
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        alignment: center;

                        // 小見出し
                        Text {
                            text: "出力";
                            font-size: 13px;
                            font-weight: FontWeight.medium;
                            color: Palette.foreground.transparentize(0.3);
                        }

                        Button {
                            text: "GIF出力";
                            primary: true;
                            enabled: frames.length > 0;
                            clicked => {
                                root.export-gif();
                            }
                        }

                        Button {
                            text: "画像出力";
                            primary: true;
                            enabled: frames.length > 0;
                            clicked => {
                                root.export-selected-image();
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.foreground.transparentize(0.7);
                    }
                }

                if current-tab == 1: VerticalLayout {
                    Text {
                        text: "...";
                        color: Palette.foreground.transparentize(0.5);
                    }
                }
            }
        }
    }
}
