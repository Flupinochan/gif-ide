import { MessageDialog } from "../message-dialog.slint";

export component MessageDialogPreview inherits MessageDialog {
    title-text: "エラーが発生しました";
    message: "GIF ファイルの読み込みに失敗しました。\n\nファイルが破損しているか、サポートされていない形式の可能性があります。\n\n考えられる原因:\n1. ファイルが別のアプリケーションによって使用中です。\n2. ファイルのパスに特殊文字が含まれています。\n3. ディスクの空き容量が不足しています。\n4. ファイルのアクセス権限が不足しています。\n5. GIF ファイルのフォーマットが古すぎるか、新しすぎます。\n\n対処方法:\n- ファイルを別の場所にコピーしてから再度お試しください。\n- アプリケーションを再起動してから再度お試しください。\n- ファイルが正常な GIF ファイルであることを確認してください。";
}
