import {
    ScrollView,
    StandardButton,
    LineEdit,
    Button,
    Slider,
    ComboBox,
    Spinner,
    Palette,
    Switch,
} from "std-widgets.slint";
import { SelectionGroup } from "selection-group.slint";
import { Style } from "global-styles.slint";
import { LoadingState } from "loading-state.slint";

export component ExportFileWindow inherits Window {
    in-out property <int> format-index: 0;
    in-out property <string> export-path: "";
    out property <bool> is-gif: format-index == 0;
    out property <bool> is-jpeg: format-index == 2;
    out property <bool> is-ico: format-index == 5;
    in-out property <int> ico-filter-type-index: 0;
    in-out property <bool> composite-white-background: false;
    in-out property <bool> gif-loop-forever: true;
    in-out property <bool> gif-optimize: false;
    in-out property <int> range-index: 0;
    in-out property <float> quality: 100;
    in property <LoadingState> state: LoadingState.form;
    in property <int> progress-current: 0;
    in property <int> progress-total: 0;
    callback select-export-path();
    callback start-export();
    callback cancel();
    callback open-export-folder();

    // FileDialogと干渉するため設定しないこと
    // always-on-top: true;
    title: @tr("ファイル出力");
    default-font-family: Style.font-family;
    height: self.preferred-height;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        if root.state == LoadingState.success: Rectangle {
            background: Colors.green.transparentize(0.85);
            border-radius: 6px;

            HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Image {
                        source: @image-url("assets/check.svg");
                        colorize: Colors.green;
                        width: 16px;
                        height: 16px;
                    }

                    Text {
                        text: @tr("出力に成功しました");
                        vertical-alignment: center;
                        color: Colors.darkgreen;
                    }
                }

                TouchArea {
                    width: open-text.preferred-width;
                    height: open-text.preferred-height;
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-export-folder();
                    }

                    open-text := Text {
                        text: @tr("開く");
                        vertical-alignment: center;
                        color: Palette.accent-background;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 10px;
            Text {
                text: @tr("形式");
                font-size: 14px;
                font-weight: FontWeight.medium;
                vertical-alignment: center;
            }

            ComboBox {
                model: ["GIF", "PNG", "JPEG", "WEBP", "BMP", "ICO", "AVIF"];
                current-index <=> root.format-index;
                selected(current-value) => {
                    root.export-path = "";
                }
            }

            if root.is-ico: Text {
                text: @tr("256pxを超える場合は256pxに縮小されます");
                font-size: 12px;
                color: Palette.foreground.transparentize(0.4);
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            spacing: 10px;
            Text {
                text: @tr("保存先");
                font-size: 14px;
                font-weight: FontWeight.medium;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 10px;

                LineEdit {
                    text <=> root.export-path;
                }

                Button {
                    icon: @image-url("assets/folder-open.svg");
                    colorize-icon: true;
                    clicked => {
                        root.select-export-path();
                    }
                }
            }
        }

        if !root.is-gif: VerticalLayout {
            spacing: 10px;
            Text {
                text: @tr("範囲");
                font-size: 14px;
                font-weight: FontWeight.medium;
                vertical-alignment: center;
            }

            SelectionGroup {
                options: [@tr("現在のフレーム"), @tr("すべて")];
                selected-index <=> root.range-index;
            }
        }

        if root.is-ico: HorizontalLayout {
            spacing: 10px;
            alignment: start;

            ComboBox {
                model: ["Nearest", "Triangle", "CatmullRom", "Gaussian", "Lanczos3"];
                current-index <=> root.ico-filter-type-index;
            }

            Text {
                text: @tr("補間方式");
                vertical-alignment: center;
            }
        }

        // JPEGは常に白背景合成のためスイッチは不要
        if !root.is-gif && !root.is-jpeg: HorizontalLayout {
            padding-top: 5px;
            spacing: 10px;
            Switch {
                text: @tr("透明部分を白背景に合成");
                checked: composite-white-background;
                toggled => {
                    composite-white-background = !composite-white-background;
                }
            }
        }

        if root.is-gif: HorizontalLayout {
            padding-top: 5px;
            spacing: 10px;
            Switch {
                text: @tr("ループ");
                checked: gif-loop-forever;
                toggled => {
                    gif-loop-forever = !gif-loop-forever;
                }
            }
            Switch {
                text: @tr("サイズ最適化 (不透明な内容のみ効果あり)");
                checked: gif-optimize;
                toggled => {
                    gif-optimize = !gif-optimize;
                }
            }
        }

        if root.is-jpeg: VerticalLayout {
            spacing: 10px;

            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: @tr("品質");
                    font-size: 14px;
                    font-weight: FontWeight.medium;
                    vertical-alignment: center;
                }

                Text {
                    text: round(root.quality);
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 4px;

                Text {
                    text: "0";
                }

                Slider {
                    minimum: 0;
                    maximum: 100;
                    step: 1;
                    value <=> root.quality;
                }

                Text {
                    text: "100";
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            padding-top: 10px;
            spacing: 10px;

            if root.state == LoadingState.form || root.state == LoadingState.success: Button {
                text: "OK";
                primary: true;
                enabled: root.export-path != "";
                clicked => {
                    root.start-export();
                }
            }

            if root.state == LoadingState.processing: HorizontalLayout {
                spacing: 8px;
                Spinner {
                    indeterminate: true;
                }
                if root.progress-total > 0: Text {
                    text: root.progress-current + " / " + root.progress-total;
                    vertical-alignment: center;
                }
            }

            Button {
                text: "Cancel";
                enabled: root.state == LoadingState.form || root.state == LoadingState.success;
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
