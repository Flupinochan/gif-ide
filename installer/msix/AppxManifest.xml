<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for Microsoft Store submission.
  $VERSION$ is replaced by installer/build-msix.ps1 (from Cargo.toml).

  NOTE (Store submission): Identity Name / Publisher and PublisherDisplayName
  must exactly match the values shown in Partner Center under
  "Product management" > "Product identity" (current values are set below).
  Local install testing via build-msix.ps1 -CertThumbprint requires a
  self-signed certificate whose Subject equals the Publisher value below.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="MetalMental.GIF-IDE"
      Publisher="CN=3C60EF58-65BB-49C9-A680-D10CF22EF565"
      Version="$VERSION$.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GIF-IDE</DisplayName>
    <PublisherDisplayName>MetalMental</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ja" />
  </Resources>

  <Applications>
    <Application Id="gifide" Executable="gif-ide.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="GIF-IDE"
          Description="GIF player and editor"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
